# 复制此文件为 .env 并填写你的配置

# DeepSeek API Key（在 platform.deepseek.com 获取）
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# 服务端口
PORT=8000

# QQ 邮件推送（重要度 ≥ 8 的新闻抓取后自动发送）
# 注意：SMTP_PASS 填写 QQ 邮箱的"授权码"，不是登录密码
# 在 QQ 邮箱设置 → 账户 → POP3/IMAP/SMTP 中开启并获取授权码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-qq@qq.com
SMTP_PASS=your-smtp-authorization-code
NOTIFY_EMAIL=recipient@example.com
